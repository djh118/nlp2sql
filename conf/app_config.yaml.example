logging:
  file:
    enable: true
    level: INFO
    path: logs
    rotation: "10 MB"
    retention: "7 days"
  console:
    enable: true
    level: INFO

db_meta:
  host: localhost
  port: 3306
  user: root
  password: YOUR_PASSWORD
  database: meta

db_dw:
  host: localhost
  port: 3306
  user: root
  password: YOUR_PASSWORD
  database: dw

qdrant:
  host: localhost
  port: 6333
  embedding_size: 1024

embedding:
  host: localhost
  port: 8081
  model: BAAI/bge-large-zh-v1.5

es:
  host: localhost
  port: 9200
  index_name: data_agent

feishu:
  app_id: "YOUR_FEISHU_APP_ID"
  app_secret: "YOUR_FEISHU_APP_SECRET"

llm:
  model_name: deepseek-v4-flash
  sql_model_name: deepseek-v4-flash
  api_key: YOUR_DEEPSEEK_API_KEY

langfuse:
  enabled: true
  secret_key: "YOUR_LANGFUSE_SECRET_KEY"
  public_key: "YOUR_LANGFUSE_PUBLIC_KEY"
  host: https://cloud.langfuse.com

fault_tolerance:
  retry:
    max_retries: 2
    base_delay: 1.0
    max_delay: 30.0
    backoff_factor: 2.0
  circuit_breaker:
    vector_retrieval:
      failure_threshold: 5
      recovery_timeout: 30
    llm_call:
      failure_threshold: 3
      recovery_timeout: 60
    sql_execution:
      failure_threshold: 3
      recovery_timeout: 30
  llm_fallback:
    model_name: deepseek-v4-flash
    backup_model_name: deepseek-v4-flash
  sql_guard:
    block_select_star: true
    block_no_where: true
    max_retry_count: 3
  rate_limit:
    enabled: true
    max_requests: 60
    window_seconds: 60
  cache:
    slow_query_threshold_ms: 5000
    max_cache_size: 100
    cache_ttl_seconds: 300
  query_timeout:
    embedding: 10
    qdrant_search: 10
    es_search: 10
    llm_invoke: 30
    sql_execute: 60
    mysql_connect: 10
